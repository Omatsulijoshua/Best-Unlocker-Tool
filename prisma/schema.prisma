generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  BLOCKED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LicenseStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
}

enum TicketStatus {
  OPEN
  IN_REVIEW
  WAITING_FOR_USER
  RESOLVED
  REJECTED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model User {
  id                String                  @id @default(cuid())
  name              String
  email             String                  @unique
  passwordHash      String
  emailVerifiedAt   DateTime?
  role              UserRole                @default(USER)
  status            UserStatus              @default(PENDING)
  blockedReason     String?
  failedLoginCount  Int                     @default(0)
  suspiciousUntil   DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  payments          Payment[]
  licenses          License[]
  devices           UserDevice[]
  sessions          LoginSession[]
  activities        ActivityLog[]
  adminActions      AdminActionLog[]        @relation("AdminActor")
  affectedActions   AdminActionLog[]        @relation("AdminTarget")
  tickets           SupportTicket[]
  reminders         PasswordReminder[]
  checklists        AccessChecklist[]
  wizardSessions    RecoveryWizardSession[]
}

model SubscriptionPlan {
  id          String    @id @default(cuid())
  name        String    @unique
  description String
  priceCents  Int
  currency    String    @default("USD")
  durationDays Int
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  payments    Payment[]
  licenses    License[]
}

model Payment {
  id           String        @id @default(cuid())
  userId       String
  planId       String
  amountCents  Int
  currency     String        @default("USD")
  provider     String        @default("manual")
  reference    String?
  proofUrl     String?
  status       PaymentStatus @default(PENDING)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])
  plan         SubscriptionPlan @relation(fields: [planId], references: [id])
  license      License?
}

model License {
  id          String        @id @default(cuid())
  userId      String
  planId      String
  paymentId   String        @unique
  status      LicenseStatus @default(PENDING)
  startsAt    DateTime?
  expiresAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id])
  plan        SubscriptionPlan @relation(fields: [planId], references: [id])
  payment     Payment       @relation(fields: [paymentId], references: [id])
}

model UserDevice {
  id            String   @id @default(cuid())
  userId        String
  deviceIdHash  String
  fingerprint   Json
  label         String?
  active        Boolean  @default(true)
  lastSeenAt    DateTime @default(now())
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, deviceIdHash])
}

model LoginSession {
  id             String    @id @default(cuid())
  userId         String
  deviceIdHash   String
  refreshTokenHash String
  ipAddress      String?
  userAgent      String?
  active         Boolean   @default(true)
  lastActivityAt DateTime  @default(now())
  expiresAt      DateTime
  closedAt       DateTime?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model AdminActionLog {
  id            String   @id @default(cuid())
  adminId       String
  targetUserId  String?
  action        String
  before        Json?
  after         Json?
  ipAddress     String?
  createdAt     DateTime @default(now())
  admin         User     @relation("AdminActor", fields: [adminId], references: [id])
  targetUser    User?    @relation("AdminTarget", fields: [targetUserId], references: [id])
}

model RecoveryCategory {
  id        String          @id @default(cuid())
  name      String          @unique
  slug      String          @unique
  guides    RecoveryGuide[]
  createdAt DateTime        @default(now())
}

model RecoveryGuide {
  id          String   @id @default(cuid())
  categoryId  String
  title       String
  slug        String   @unique
  excerpt     String
  body        String
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  category    RecoveryCategory @relation(fields: [categoryId], references: [id])
}

model RecoveryWizardSession {
  id                  String   @id @default(cuid())
  userId              String?
  systemType          String
  ownsOrAdministers   Boolean
  availableProof      Json
  generatedGuidance   String
  suspicious          Boolean  @default(false)
  createdAt           DateTime @default(now())
  user                User?    @relation(fields: [userId], references: [id])
}

model SupportTicket {
  id          String         @id @default(cuid())
  userId      String
  title       String
  systemType  String
  description String
  proofChecklist Json
  priority    TicketPriority @default(NORMAL)
  status      TicketStatus   @default(OPEN)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id])
  messages    TicketMessage[]
  attachments TicketAttachment[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
}

model TicketAttachment {
  id        String   @id @default(cuid())
  ticketId  String
  url       String
  fileName  String
  createdAt DateTime @default(now())
  ticket    SupportTicket @relation(fields: [ticketId], references: [id])
}

model PasswordReminder {
  id        String   @id @default(cuid())
  userId    String
  label     String
  cadenceDays Int
  nextDueAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model AccessChecklist {
  id        String   @id @default(cuid())
  userId    String
  title     String
  items     Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model DeviceChipset {
  id          String        @id @default(cuid())
  family      String
  vendor      String
  slug        String        @unique
  description String
  safeNotes   String
  models      DeviceModel[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model DeviceBrand {
  id        String        @id @default(cuid())
  name      String        @unique
  slug      String        @unique
  models    DeviceModel[]
  createdAt DateTime      @default(now())
}

model DeviceModel {
  id              String        @id @default(cuid())
  brandId         String
  chipsetId       String
  name            String
  slug            String        @unique
  aliases         String[]
  platform        String
  supportedModes  String[]
  safeOperations  String[]
  officialNotes   String
  riskNotes       String
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  brand           DeviceBrand   @relation(fields: [brandId], references: [id])
  chipset         DeviceChipset @relation(fields: [chipsetId], references: [id])
}
